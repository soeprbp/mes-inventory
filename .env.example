# MES Inventory hosted-app environment template
#
# Copy this to .env.local for local development. Never commit .env.local.

# Cloudflare account API token for account/bucket management.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 S3-compatible credentials for object operations and presigned URLs.
R2_BUCKET_NAME=mes-inventory-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Browser origins allowed to use R2 presigned URLs.
R2_CORS_ORIGINS=http://localhost:3000

# Future hosted app settings.
DATABASE_URL=
APP_PASSCODE_HASH=sha256:
APP_SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
AI_PROVIDER=opencode-go
OPENCODE_API_KEY=
OPENCODE_GO_MODEL=kimi-k2.6
OPENCODE_GO_MODELS=kimi-k2.6,kimi-k2.7-code,mimo-v2.5-pro,mimo-v2.5,minimax-m2.5
WORKER_SECRET=
